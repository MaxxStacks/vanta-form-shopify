<a class="col" href="{{ product.url }}">
  {% render 'vf-slot', image: product.featured_image, caption: 'Packshot on seamless white, three-quarter view, soft shadow.', alt: product.title, sizes: '(min-width: 900px) 33vw, 50vw' %}
  <div class="row"><h3>{{ product.title }}</h3><span class="sm">{% if product.price_varies %}From {% endif %}{{ product.price_min | money }}</span></div>
  {%- if product.metafields.custom.short_description != blank -%}<p>{{ product.metafields.custom.short_description }}</p>{%- endif -%}
  {%- unless product.available -%}<p class="k">Sold out</p>{%- endunless -%}
  <span class="lnk">Discover</span>
</a>
