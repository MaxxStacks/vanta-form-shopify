<article class="product-card">
  <a href="{{ product.url }}">
    <div class="product-card__media">
      {% if product.featured_image %}
        {{ product.featured_image | image_url: width: 900 | image_tag: widths: '400,600,900', loading: 'lazy', alt: product.featured_image.alt | default: product.title }}
      {% endif %}
    </div>
    <div class="product-card__body">
      <div class="product-card__title">{{ product.title }}</div>
      <div class="product-card__meta">{{ product.price | money_with_currency }}</div>
    </div>
  </a>
</article>