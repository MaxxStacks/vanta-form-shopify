<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#0b0a0b">

    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} – tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} – Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} – {{ shop.name }}{% endunless -%}
    </title>

    {%- capture vf_meta_description -%}{% if page_description %}{{ page_description }}{% elsif request.page_type == 'index' %}VANTA FORM designs and manufactures original fit-led intimate wear for discretion, control, transformation and expression. Canada, United States and international expansion.{% elsif request.page_type == 'collection' %}Explore {{ collection.title }} by VANTA FORM — original intimate-wear architecture developed around fit, profile and expression.{% elsif request.page_type == 'page' %}{{ page.content | strip_html | strip_newlines | truncate: 155 }}{% else %}Precision intimate engineering by VANTA FORM.{% endif %}{%- endcapture -%}
    <meta name="description" content="{{ vf_meta_description | strip | escape }}">
    {% if request.page_type == '404' or request.page_type == 'search' or request.page_type == 'collection' and collection.products_count == 0 %}<meta name="robots" content="noindex,follow">{% endif %}

    {% render 'meta-social' %}
    {% render 'structured-data' %}

    {{ content_for_header }}

    {{ 'base.css' | asset_url | stylesheet_tag: preload: true }}
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
  </head>

  <body class="template-{{ request.page_type | handle }}">
    <a class="skip-link" href="#MainContent">{{ 'general.accessibility.skip_to_content' | t | default: 'Skip to content' }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
  </body>
</html>