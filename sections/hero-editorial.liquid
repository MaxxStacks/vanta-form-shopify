<section class="vf-hero">
  {% if section.settings.image != blank %}
    <div class="vf-hero__media">{{ section.settings.image | image_url: width: 2200 | image_tag: widths: '750,1100,1600,2200', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: section.settings.image.alt | default: section.settings.heading }}</div>
  {% endif %}
  <div class="vf-hero__veil"></div>
  <div class="page-width vf-hero__content">
    <div class="vf-hero__copy">
      <div class="eyebrow">{{ section.settings.eyebrow }}</div>
      <h1 class="vf-display">{{ section.settings.heading | newline_to_br }}</h1>
      <p class="vf-hero__lead">{{ section.settings.copy }}</p>
      <div class="vf-actions">
        <a class="btn" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">{{ section.settings.primary_label }} <span aria-hidden="true">→</span></a>
        <a class="btn btn--ghost" href="{{ section.settings.secondary_link | default: '/pages/fit-lab' }}">{{ section.settings.secondary_label }} <span aria-hidden="true">→</span></a>
      </div>
      <div class="vf-hero__motives" aria-label="Designed for"><span>Discretion</span><span>Control</span><span>Transformation</span><span>Expression</span></div>
    </div>
  </div>
</section>
{% schema %}
{"name":"VANTA hero","settings":[
{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Precision · Expression · Freedom"},
{"type":"textarea","id":"heading","label":"Heading","default":"YOUR BODY.\nYOUR FORM."},
{"type":"textarea","id":"copy","label":"Copy","default":"Precision-manufactured intimate wear created for control, discretion, transformation and expression."},
{"type":"image_picker","id":"image","label":"Hero image"},
{"type":"text","id":"primary_label","label":"Primary button","default":"Find yours"},{"type":"url","id":"primary_link","label":"Primary link"},
{"type":"text","id":"secondary_label","label":"Secondary button","default":"Build yours"},{"type":"url","id":"secondary_link","label":"Secondary link"}
],"presets":[{"name":"VANTA hero"}]}
{% endschema %}