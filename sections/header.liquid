{%- if section.settings.announcement != blank -%}
<div class="bar">{% if section.settings.announcement_link != blank %}<a href="{{ section.settings.announcement_link }}">{{ section.settings.announcement | escape }}</a>{% else %}{{ section.settings.announcement | escape }}{% endif %}</div>
{%- endif -%}
<header class="hdr" data-vf-header><div class="wrap">
  <div style="display:flex;align-items:center;gap:28px">
    <button class="ib burger" type="button" data-vf-open="menu" aria-label="Open menu"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 7h18M3 17h18"/></svg></button>
    <nav class="nav" aria-label="Primary">
      {%- for link in section.settings.menu_left.links -%}<a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>{%- else -%}
      <a href="{{ routes.all_products_collection_url }}">Shop</a><a href="/collections/core">Chastity</a><a href="/collections/fufu">Feminization</a><a href="/pages/couples-keyholders">Keyholders</a>
      {%- endfor -%}
    </nav>
  </div>
  <a class="logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }} home">{% if settings.logo != blank %}{{ settings.logo | image_url: width: 360 | image_tag: alt: shop.name, loading: 'eager' }}{% else %}{{ shop.name }}{% endif %}</a>
  <div class="icons">
    <nav class="nav" aria-label="Secondary">
      {%- for link in section.settings.menu_right.links -%}<a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>{%- else -%}
      <a href="/pages/fit-lab">Find your fit</a><a href="/pages/manufacturing">Manufacturing</a>
      {%- endfor -%}
    </nav>
    <a class="ib" href="{{ routes.search_url }}" data-vf-open="search" aria-label="Search"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg></a>
    <a class="ib" href="{{ routes.cart_url }}" data-vf-open="bag" aria-label="Open bag"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 8h14l-1 13H6L5 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg><span class="bdg" data-vf-count data-n="{{ cart.item_count }}">{{ cart.item_count }}</span></a>
  </div>
</div></header>
{% schema %}
{"name":"Header","settings":[
{"type":"text","id":"announcement","label":"Announcement bar","default":"Discreet shipping · Lifetime Lock Warranty · 15% off your first form"},
{"type":"url","id":"announcement_link","label":"Announcement link"},
{"type":"link_list","id":"menu_left","label":"Left menu"},
{"type":"link_list","id":"menu_right","label":"Right menu"}
]}
{% endschema %}
