<header class="header-shell">
  <div class="page-width header">
    <button class="vf-menu-toggle" type="button" aria-expanded="false" aria-controls="vf-mobile-nav"><span></span><span></span><span class="visually-hidden">Menu</span></button>
    <a class="brand" href="{{ routes.root_url }}" aria-label="VANTA FORM home">VANTA FORM<small>Precision intimate engineering</small></a>
    <nav class="nav" aria-label="Primary">{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}</nav>
    <div class="header-actions"><a href="{{ routes.search_url }}">Search</a><a href="{{ routes.account_url }}">Account</a><a href="{{ routes.cart_url }}">Bag <span data-cart-count>{{ cart.item_count }}</span></a></div>
  </div>
  <nav id="vf-mobile-nav" class="vf-mobile-nav" aria-label="Mobile" hidden>
    {% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}
    <a href="/pages/fit-lab">Fit Lab</a><a href="{{ routes.search_url }}">Search</a><a href="{{ routes.account_url }}">Account</a>
  </nav>
</header>
{% schema %}{"name":"Header","settings":[{"type":"link_list","id":"menu","label":"Menu","default":"main-menu"}]}{% endschema %}