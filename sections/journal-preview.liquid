{% assign journal = blogs['journal'] %}<section class="section vf-home-journal"><div class="page-width"><div class="section-head"><div><span class="eyebrow">VANTA FORM Journal</span><h2 class="vf-editorial">Read deeper.</h2></div><a class="text-link" href="/blogs/journal">View Journal →</a></div><div class="vf-journal-grid">{% for article in journal.articles limit:3 %}<article class="vf-journal-card"><a href="{{ article.url }}">{% if article.image %}{{ article.image | image_url:width:900 | image_tag:loading:'lazy',alt:article.title }}{% endif %}<span class="eyebrow">{{ article.tags.first | default:'Journal' }}</span><h3>{{ article.title }}</h3><p>{{ article.excerpt_or_content | strip_html | truncatewords:24 }}</p><span>Read →</span></a></article>{% endfor %}</div></div></section>{% schema %}{"name":"Journal preview","settings":[],"presets":[{"name":"Journal preview"}]}{% endschema %}