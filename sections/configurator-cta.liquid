<section class="vf-fit section">
  <div class="page-width vf-fit__grid">
    <div class="vf-fit__intro"><span class="eyebrow">{{ section.settings.eyebrow }}</span><h2 class="vf-editorial">{{ section.settings.heading | newline_to_br }}</h2><p class="lead">{{ section.settings.copy }}</p><a class="btn" href="{{ section.settings.link | default: '/pages/fit-lab' }}">{{ section.settings.label }} →</a></div>
    <ol class="vf-fit__steps">
      <li><b>01</b><strong>Measure</strong><span>Start with your measurements.</span></li>
      <li><b>02</b><strong>Choose</strong><span>Select profile and architecture.</span></li>
      <li><b>03</b><strong>Express</strong><span>Choose form, finish and details.</span></li>
      <li><b>04</b><strong>Configure</strong><span>Complete your personal configuration.</span></li>
    </ol>
  </div>
</section>
{% schema %}
{"name":"Fit Lab CTA","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"VANTA FORM Fit Lab"},{"type":"textarea","id":"heading","label":"Heading","default":"NOT SMALL.\nNOT MEDIUM.\nYOURS."},{"type":"textarea","id":"copy","label":"Copy","default":"A fit experience designed around your body, your preferred profile and the way you intend to wear."},{"type":"text","id":"label","label":"Button","default":"Start your Fit Lab"},{"type":"url","id":"link","label":"Link"}],"presets":[{"name":"Fit Lab CTA"}]}
{% endschema %}