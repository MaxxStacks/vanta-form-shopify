<section class="vf-page-hero vf-page-hero--compact"><div class="page-width"><span class="eyebrow">Discover</span><h1 class="vf-editorial">Search VANTA FORM.</h1><form class="vf-search-form" action="{{ routes.search_url }}" method="get" role="search"><input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search collections, fit, products…" autocomplete="off"><button type="submit">Search →</button></form></div></section>{% if search.performed %}<section class="section"><div class="page-width"><div class="section-head"><p>{{ search.results_count }} results for “{{ search.terms | escape }}”</p></div><div class="collection-grid">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', product:item %}{% else %}<a class="vf-search-result" href="{{ item.url }}"><span class="eyebrow">{{ item.object_type }}</span><h2>{{ item.title }}</h2><p>{{ item.content | strip_html | truncatewords:24 }}</p></a>{% endif %}{% else %}<div class="vf-empty-state"><h2>No exact match.</h2><p>Try a collection name, fit, discreet, feminine, custom or browse the Fit Lab.</p><a class="btn" href="/pages/fit-lab">Open Fit Lab</a></div>{% endfor %}</div></div></section>{% endif %}
{% schema %}{"name":"Main search","settings":[]}{% endschema %}