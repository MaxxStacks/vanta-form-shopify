<section class="section"><div class="page-width"><h1 class="h1">Search</h1>
<form action="{{ routes.search_url }}" method="get" role="search"><input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search VANTA FORM"><button class="btn" type="submit">Search</button></form>
{% if search.performed %}<div class="collection-grid">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', product: item %}{% endif %}{% endfor %}</div>{% endif %}
</div></section>
{% schema %}{"name":"Main search","settings":[]}{% endschema %}