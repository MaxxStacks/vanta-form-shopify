<section class="section">
<div class="page-width">
  <div class="section-head">
    <div><span class="eyebrow">{{ section.settings.eyebrow }}</span><h2 class="h2">{{ section.settings.heading }}</h2></div>
    {% if section.settings.link != blank %}<a class="text-link" href="{{ section.settings.link }}">View all collections →</a>{% endif %}
  </div>
  <div class="feature-collections">
    {% for block in section.blocks %}
      {% assign collection = block.settings.collection %}
      <a class="feature-collection" href="{{ collection.url | default: '#' }}" {{ block.shopify_attributes }}>
        <div class="feature-collection__media">
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 1200 | image_tag: widths:'600,900,1200', loading:'lazy', alt:block.settings.heading }}
          {% elsif collection.featured_image %}
            {{ collection.featured_image | image_url: width: 1200 | image_tag: widths:'600,900,1200', loading:'lazy', alt:collection.title }}
          {% endif %}
        </div>
        <div class="feature-collection__body">
          <span class="eyebrow">0{{ forloop.index }}</span>
          <h3>{{ block.settings.heading | default: collection.title }}</h3>
          <p>{{ block.settings.copy }}</p>
          <span class="text-link">Discover →</span>
        </div>
      </a>
    {% endfor %}
  </div>
</div>
</section>
{% schema %}
{"name":"Featured collections","settings":[
{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Collections"},
{"type":"text","id":"heading","label":"Heading","default":"Distinct by design."},
{"type":"url","id":"link","label":"All collections link"}
],"blocks":[{"type":"collection","name":"Collection","settings":[
{"type":"collection","id":"collection","label":"Collection"},
{"type":"image_picker","id":"image","label":"Override image"},
{"type":"text","id":"heading","label":"Heading","default":"CORE"},
{"type":"textarea","id":"copy","label":"Copy","default":"The essential VANTA FORM architecture."}
]}],"max_blocks":3,"presets":[{"name":"Featured collections","blocks":[{"type":"collection"},{"type":"collection"},{"type":"collection"}]}]}
{% endschema %}