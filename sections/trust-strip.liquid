<section class="trust-strip" aria-label="VANTA FORM standards">
<div class="page-width trust-strip__grid">
{% for block in section.blocks %}
<div class="trust-item" {{ block.shopify_attributes }}><strong>{{ block.settings.heading }}</strong><span>{{ block.settings.copy }}</span></div>
{% endfor %}
</div>
</section>
{% schema %}
{"name":"Trust strip","blocks":[{"type":"item","name":"Item","settings":[
{"type":"text","id":"heading","label":"Heading","default":"Discreet by default"},
{"type":"text","id":"copy","label":"Copy","default":"Private packaging and billing"}
]}],"max_blocks":4,"presets":[{"name":"Trust strip","blocks":[{"type":"item"},{"type":"item"},{"type":"item"},{"type":"item"}]}]}
{% endschema %}