<section class="vf-page-hero vf-page-hero--compact"><div class="page-width"><span class="eyebrow">VANTA FORM</span><h1 class="vf-editorial">Your bag.</h1></div></section><section class="section"><div class="page-width">{% if cart.item_count == 0 %}<div class="vf-empty-state"><h2>Your bag is empty.</h2><p>Start with the collection universe or use the Fit Lab to find the right direction.</p><a class="btn" href="{{ routes.all_products_collection_url }}">Explore VANTA FORM</a></div>{% else %}<form action="{{ routes.cart_url }}" method="post" class="vf-cart"><div class="vf-cart__items">{% for item in cart.items %}<article class="vf-cart-item">{% if item.image %}<a href="{{ item.url }}">{{ item.image | image_url: width: 260 | image_tag: loading:'lazy', alt:item.product.title }}</a>{% endif %}<div><span class="eyebrow">{{ item.product.vendor }}</span><h2><a href="{{ item.url }}">{{ item.product.title }}</a></h2>{% unless item.variant.title == 'Default Title' %}<p>{{ item.variant.title }}</p>{% endunless %}<label>Quantity <input type="number" name="updates[]" value="{{ item.quantity }}" min="0"></label><a href="{{ item.url_to_remove }}">Remove</a></div><strong>{{ item.final_line_price | money_with_currency }}</strong></article>{% endfor %}<button class="btn btn--ghost" type="submit" name="update">Update bag</button></div><aside class="vf-cart__summary"><span class="eyebrow">Order summary</span><div><span>Subtotal</span><strong>{{ cart.total_price | money_with_currency }}</strong></div><p>Shipping, taxes and duties are calculated or confirmed during checkout where applicable.</p><button class="btn" type="submit" name="checkout">Secure checkout →</button><small>Canada · United States · Worldwide availability varies by destination.</small></aside></form>{% endif %}</div></section>
{% schema %}{"name":"Main cart","settings":[]}{% endschema %}