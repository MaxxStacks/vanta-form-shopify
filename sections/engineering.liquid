<section class="vf-manufacturing section">
  <div class="page-width vf-manufacturing__grid">
    <div class="vf-manufacturing__media">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1500 | image_tag: widths:'700,1000,1500', loading:'lazy', alt:section.settings.heading }}{% else %}<div class="vf-manufacturing__placeholder"><span>VANTA FORM / MANUFACTURING</span></div>{% endif %}</div>
    <div class="vf-manufacturing__copy">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="vf-editorial">{{ section.settings.heading }}</h2>
      <p class="lead">{{ section.settings.copy }}</p>
      <div class="vf-proof-list">{% for block in section.blocks %}<div {{ block.shopify_attributes }}><span>0{{ forloop.index }}</span><strong>{{ block.settings.heading }}</strong><p>{{ block.settings.text }}</p></div>{% endfor %}</div>
      {% if section.settings.link != blank %}<a class="btn btn--ghost" href="{{ section.settings.link }}">Our manufacturing →</a>{% endif %}
    </div>
  </div>
</section>
{% schema %}
{"name":"Manufacturing story","settings":[
{"type":"text","id":"eyebrow","label":"Eyebrow","default":"We manufacture"},
{"type":"text","id":"heading","label":"Heading","default":"A higher standard."},
{"type":"textarea","id":"copy","label":"Copy","default":"Premium materials deserve equally serious fabrication. VANTA FORM combines original product design with high-quality manufacturing standards and two decades of manufacturing experience behind the way we approach fit, finish and production."},
{"type":"image_picker","id":"image","label":"Manufacturing image"},{"type":"url","id":"link","label":"Manufacturing page"}],
"blocks":[{"type":"point","name":"Proof point","settings":[{"type":"text","id":"heading","label":"Heading","default":"Original design"},{"type":"textarea","id":"text","label":"Text","default":"Developed as VANTA FORM product architecture, not sourced as generic catalog merchandise."}]}],"max_blocks":5,
"presets":[{"name":"Manufacturing story","blocks":[{"type":"point"},{"type":"point"},{"type":"point"}]}]}
{% endschema %}