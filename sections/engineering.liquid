<section class="section">
  <div class="page-width split">
    <div>
      <div class="eyebrow">{{ section.settings.eyebrow }}</div>
      <h2 class="h2">{{ section.settings.heading }}</h2>
      <p class="lead">{{ section.settings.copy }}</p>
      <div class="tech-list">
        {% for block in section.blocks %}
          <div {{ block.shopify_attributes }}><b>0{{ forloop.index }}</b><span>{{ block.settings.text }}</span></div>
        {% endfor %}
      </div>
    </div>
    <div class="split__visual">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1200 | image_tag: widths: '600,900,1200', loading: 'lazy', alt: section.settings.image.alt | default: section.settings.heading }}
      {% else %}
        <span class="eyebrow">Exploded engineering visual</span>
      {% endif %}
    </div>
  </div>
</section>
{% schema %}
{
  "name":"Engineering story",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Engineering"},
    {"type":"text","id":"heading","label":"Heading","default":"Designed differently."},
    {"type":"textarea","id":"copy","label":"Copy","default":"A modular architecture built around precision sizing, discreet hardware and additive manufacturing."},
    {"type":"image_picker","id":"image","label":"Image"}
  ],
  "blocks":[
    {"type":"point","name":"Point","settings":[{"type":"text","id":"text","label":"Text","default":"Precision additive manufacturing"}]}
  ],
  "max_blocks":5,
  "presets":[{"name":"Engineering story","blocks":[{"type":"point"},{"type":"point"},{"type":"point"},{"type":"point"},{"type":"point"}]}]
}
{% endschema %}