<footer class="footer">
  <div class="page-width footer-grid">
    <div>
      <h3>{{ shop.name }}</h3>
      <p>Precision intimate engineering. Custom-fit, discreetly fulfilled.</p>
    </div>
    {% for block in section.blocks %}
      <div {{ block.shopify_attributes }}>
        <h3>{{ block.settings.heading }}</h3>
        <ul>
          {% for link in block.settings.menu.links %}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {% endfor %}
        </ul>
      </div>
    {% endfor %}
  </div>
</footer>
{% schema %}
{
  "name":"Footer",
  "max_blocks":3,
  "blocks":[
    {"type":"menu","name":"Menu","settings":[
      {"type":"text","id":"heading","label":"Heading","default":"Explore"},
      {"type":"link_list","id":"menu","label":"Menu"}
    ]}
  ],
  "presets":[{"name":"Footer"}]
}
{% endschema %}