{% if product %}
<section class="wrap faq">
  <div><p class="k pop">{{ section.settings.eyebrow }}</p><h2 class="cap h2" style="margin-top:12px">{{ section.settings.heading }}</h2></div>
  <div class="acc">
  {% for block in section.blocks %}
    <details {{ block.shopify_attributes }}><summary>{{ block.settings.question }}</summary><div class="pn">{{ block.settings.answer }}</div></details>
  {% endfor %}
  </div>
</section>
{% endif %}
{% schema %}
{"name":"Product FAQ","settings":[
{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Questions, answered"},
{"type":"text","id":"heading","label":"Heading","default":"Know before you order."}
],"blocks":[{"type":"faq","name":"FAQ","settings":[
{"type":"text","id":"question","label":"Question","default":"How do I choose the right fit?"},
{"type":"richtext","id":"answer","label":"Answer","default":"<p>Use the VANTA FORM measurement guide before ordering. Fit guidance is available before and after purchase.</p>"}
]}],"presets":[{"name":"Product FAQ","blocks":[{"type":"faq"},{"type":"faq"},{"type":"faq"},{"type":"faq"}]}]}
{% endschema %}
