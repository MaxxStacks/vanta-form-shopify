<section class="vf-collection-hero"><div class="page-width"><span class="eyebrow">VANTA FORM / Collection</span><h1 class="vf-editorial">{{ collection.title }}</h1>{% if collection.description != blank %}<div class="lead">{{ collection.description }}</div>{% endif %}<div class="vf-collection-meta"><span>{{ collection.products_count }} designs</span><a href="/pages/fit-lab">Need help choosing? Fit Lab →</a></div></div></section>
<section class="section vf-shop-grid"><div class="page-width">
<form class="vf-collection-tools" method="get"><div class="vf-filter-row">{% for filter in collection.filters %}<details class="vf-filter"><summary>{{ filter.label }} <span>+</span></summary><div class="vf-filter__panel">{% case filter.type %}{% when 'list' or 'boolean' %}{% for value in filter.values %}<label><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %}> <span>{{ value.label }} <small>{{ value.count }}</small></span></label>{% endfor %}{% when 'price_range' %}<div class="vf-price-filter"><input name="{{ filter.min_value.param_name }}" type="number" placeholder="Min" value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"><input name="{{ filter.max_value.param_name }}" type="number" placeholder="Max" value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"></div>{% endcase %}<button class="btn" type="submit">Apply</button></div></details>{% endfor %}</div>
<label class="vf-sort">Sort <select name="sort_by" onchange="this.form.submit()">{% assign sort_by=collection.sort_by | default: collection.default_sort_by %}{% for option in collection.sort_options %}<option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>{% endfor %}</select></label></form>
{% paginate collection.products by 24 %}<div class="collection-grid">{% for product in collection.products %}{% render 'product-card', product: product %}{% else %}<div class="vf-empty-state"><span class="eyebrow">In development</span><h2>This collection is being manufactured into reality.</h2><p>VANTA FORM will release products only when the design and production specification are ready. Explore the Fit Lab or join private correspondence for release updates.</p><div><a class="btn" href="/pages/fit-lab">Explore Fit Lab</a><a class="btn btn--ghost" href="/#newsletter">Release updates</a></div></div>{% endfor %}</div>{% if paginate.pages > 1 %}<nav class="vf-pagination">{{ paginate | default_pagination }}</nav>{% endif %}{% endpaginate %}</div></section>
{% schema %}{"name":"Main collection","settings":[]}{% endschema %}