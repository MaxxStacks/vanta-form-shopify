{% render 'breadcrumbs' %}
<section class="page-width product-main" data-product-root>
  <div class="product-gallery" aria-label="{{ product.title }} media">
    {% for media in product.media %}
      <div class="product-media" data-media-id="{{ media.id }}">
        {% if media.media_type == 'image' %}
          {% if forloop.first %}
            {{ media | image_url: width: 1800 | image_tag: widths: '600,900,1200,1600,1800', sizes: '(min-width: 960px) 60vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: media.alt | default: product.title }}
          {% else %}
            {{ media | image_url: width: 1800 | image_tag: widths: '600,900,1200,1600,1800', sizes: '(min-width: 960px) 60vw, 100vw', loading: 'lazy', alt: media.alt | default: product.title }}
          {% endif %}
        {% else %}
          {{ media | media_tag }}
        {% endif %}
      </div>
    {% else %}
      <div class="product-media product-media--placeholder"><div class="vf-pdp-cad"><span class="eyebrow">VANTA FORM / {{ product.metafields.custom.collection_label | default: product.product_type | default: 'Engineering' }}</span>{% render 'cad-art', family: product.title %}<small>CAD study shown until released product media is assigned.</small></div></div>
    {% endfor %}
  </div>

  <aside class="product-panel">
    <div class="product-kicker">{{ product.metafields.custom.collection_label | default: product.vendor | default: 'VANTA FORM' }}</div>
    <h1 class="product-title">{{ product.title }}</h1>
    <div class="product-subline">
      {% if product.metafields.custom.short_description != blank %}
        {{ product.metafields.custom.short_description }}
      {% else %}
        {{ product.description | strip_html | truncatewords: 30 }}
      {% endif %}
    </div>

    <div class="price-row">
      <div class="price" data-price>{{ product.selected_or_first_available_variant.price | money_with_currency }}</div>
      <span class="compare-price{% unless product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %} visually-hidden{% endunless %}" data-compare-price>
        {% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}{{ product.selected_or_first_available_variant.compare_at_price | money_with_currency }}{% endif %}
      </span>
    </div>

    <div class="fit-callout">
      <span class="fit-callout__mark">VF</span>
      <div><strong>Fit before checkout.</strong><span>Use our measurement system to configure with confidence.</span></div>
      <a href="{{ routes.root_url }}pages/fit-guide" data-vf-event="fit_guide_open">Fit guide →</a>
    </div>

    {% form 'product', product, class: 'product-form', data-product-form: '' %}
      {% unless product.has_only_default_variant %}
        {% for option in product.options_with_values %}
          <fieldset class="option-group" data-option-index="{{ forloop.index0 }}">
            <legend><span>{{ option.name }}</span><small data-option-value>{{ option.selected_value }}</small></legend>
            <div class="option-values">
              {% for value in option.values %}
                <label class="option-pill">
                  <input type="radio" name="options[{{ option.name | escape }}]" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %}>
                  <span>{{ value }}</span>
                </label>
              {% endfor %}
            </div>
          </fieldset>
        {% endfor %}
      {% endunless %}

      <select class="visually-hidden" name="id" data-variant-id aria-label="Variant">
        {% for variant in product.variants %}
          <option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %}>{{ variant.title }}</option>
        {% endfor %}
      </select>

      <button class="btn add-btn" type="submit" data-add-to-cart {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
        <span data-add-label>{% if product.selected_or_first_available_variant.available %}Add to bag{% else %}Unavailable{% endif %}</span>
        <span data-add-price>{% if product.selected_or_first_available_variant.available %}{{ product.selected_or_first_available_variant.price | money }}{% endif %}</span>
      </button>
    {% endform %}

    <script type="application/json" data-product-variants>
      [
        {% for variant in product.variants %}
          {
            "id": {{ variant.id | json }},
            "available": {{ variant.available | json }},
            "options": {{ variant.options | json }},
            "price": {{ variant.price | json }},
            "priceFormatted": {{ variant.price | money_with_currency | json }},
            "priceButton": {{ variant.price | money | json }},
            "compareAtPrice": {{ variant.compare_at_price | default: 0 | json }},
            "compareAtPriceFormatted": {{ variant.compare_at_price | money_with_currency | json }},
            "featuredMediaId": {{ variant.featured_media.id | default: 0 | json }}
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    </script>

    <div class="product-assurances">
      <div><strong>Original</strong><span>VANTA FORM product architecture</span></div>
      <div><strong>Fit-led</strong><span>Measure before configuration</span></div>
      <div><strong>Documented</strong><span>Released specifications over generic claims</span></div>
    </div>

    <div class="product-accordions">
      <details><summary>Fit & measurement <span>+</span></summary><div>{{ product.metafields.custom.fit_note | default: 'Measure before ordering. Detailed fit guidance and model-specific recommendations are available in our Fit Lab.' }}</div></details>
      <details><summary>Materials & care <span>+</span></summary><div>{{ product.metafields.custom.care | default: 'Material and care instructions vary by configuration and are supplied with each product.' }}</div></details>
      <details><summary>Manufacturing & lead time <span>+</span></summary><div>{{ product.metafields.custom.lead_time | default: 'Lead time is shown at checkout and may vary for custom configurations.' }}</div></details>
      <details><summary>Discreet delivery <span>+</span></summary><div>Fulfillment is designed with privacy in mind. Carrier, customs and destination requirements may require accurate shipment information. See the current shipping policy before ordering.</div></details>
    </div>
  </aside>
</section>
<div class="vf-mobile-atc"><span>{{ product.selected_or_first_available_variant.price | money_with_currency }}</span><button class="btn" type="button" data-mobile-atc {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>{% if product.selected_or_first_available_variant.available %}Add to bag →{% else %}Unavailable{% endif %}</button></div>