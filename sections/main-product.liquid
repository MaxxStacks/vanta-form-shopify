{%- liquid
  assign known = 'core,stealth,fufu,petal,arc,hex,signature,air,void,form' | split: ','
  assign family = product.collections.first
  for c in product.collections
    if known contains c.handle
      assign family = c
      break
    endif
  endfor
  assign key = family.handle | default: ''
  assign current = product.selected_or_first_available_variant
  capture default_tag
    render 'vf-copy', key: key, field: 'tag'
  endcapture
  capture default_tags
    render 'vf-copy', key: key, field: 'tags'
  endcapture
  assign colour_names = 'colour,color,couleur,finish,finition'
  assign swatch_lines = settings.swatches | newline_to_br | split: '<br />'
  assign fit_link = section.settings.fit_link | default: '/pages/fit-lab'
-%}
{% render 'breadcrumbs' %}
<div class="wrap" data-vf-product>
  <div class="pdp">
    <div class="gal">
      <div class="gmain">
        {%- if product.media.size > 0 -%}
          {%- for media in product.media -%}
            <div class="slide{% if forloop.first %} on{% endif %}">
              {%- if media.media_type == 'image' -%}
                {%- if forloop.first -%}{% render 'vf-slot', image: media, alt: product.title, eager: true, sizes: '(min-width: 1000px) 55vw, 100vw' %}{%- else -%}{% render 'vf-slot', image: media, alt: product.title, sizes: '(min-width: 1000px) 55vw, 100vw' %}{%- endif -%}
              {%- else -%}<div class="slot">{{ media | media_tag: image_size: '1400x' }}</div>{%- endif -%}
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..5) -%}
            {%- capture g -%}g{{ i }}{%- endcapture -%}
            {%- capture cap -%}{% render 'vf-copy', key: key, field: g %}{%- endcapture -%}
            <div class="slide{% if forloop.first %} on{% endif %}">{% render 'vf-slot', caption: cap, tag: 'Image' %}</div>
          {%- endfor -%}
        {%- endif -%}
      </div>
      <div class="gthumbs" role="group" aria-label="Choose image">
        {%- if product.media.size > 0 -%}
          {%- for media in product.media limit: 10 -%}
            <button type="button" data-vf-thumb="{{ forloop.index0 }}" data-media="{{ media.id }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="Show image {{ forloop.index }}">{% render 'vf-slot', image: media.preview_image, alt: '', mini: true, sizes: '120px' %}</button>
          {%- endfor -%}
        {%- else -%}
          {%- assign labels = 'Hero,Side,Worn,Detail,Box' | split: ',' -%}
          {%- for l in labels -%}<button type="button" data-vf-thumb="{{ forloop.index0 }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="Show {{ l }} image">{% render 'vf-slot', tag: l, mini: true %}</button>{%- endfor -%}
        {%- endif -%}
      </div>
    </div>

    <div class="buy">
      <div style="display:grid;gap:12px">
        <p class="k pop">{{ product.metafields.custom.collection_label | default: default_tags | replace: ',', ' ·' }}</p>
        <h1 class="cap">{{ product.title }}</h1>
        <p style="font-size:20px;font-weight:600">{{ product.metafields.custom.short_description | default: default_tag }}</p>
        <div class="price"><b data-vf-price>{{ current.price | money }}</b><s data-vf-compare{% unless current.compare_at_price > current.price %} hidden{% endunless %}>{{ current.compare_at_price | money }}</s><span class="sm">{{ cart.currency.iso_code }}{% if product.metafields.custom.lead_time != blank %} · made to order{% endif %}</span></div>
      </div>

      {%- if family and family.products_count > 1 -%}
      <fieldset><legend><span>Version</span><span>{{ product.title }}</span></legend>
        <div class="og og{% if family.products_count > 3 %}4{% else %}{{ family.products_count }}{% endif %}">
          {%- for p in family.products limit: 4 -%}<a class="o" href="{{ p.url }}"{% if p.id == product.id %} aria-current="page"{% endif %}>{{ p.title | remove: family.title | strip | default: p.title }}<small>{{ p.price_min | money }}</small></a>{%- endfor -%}
        </div>
      </fieldset>
      {%- endif -%}

      {%- form 'product', product, data-vf-product-form: '', novalidate: 'novalidate' -%}
        <input type="hidden" name="id" value="{{ current.id }}">
        <div style="display:grid;gap:28px">
        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            {%- assign oname = option.name | downcase -%}
            <fieldset data-vf-option>
              <legend><span>{{ option.name }}</span><span data-vf-option-value>{{ option.selected_value }}</span></legend>
              {%- if colour_names contains oname -%}
                <div class="sws">
                {%- for value in option.values -%}
                  {%- assign hex = '#CCCCCC' -%}
                  {%- for line in swatch_lines -%}{%- assign pair = line | strip | split: ':' -%}{%- if pair[0] == value -%}{%- assign hex = pair[1] | strip -%}{%- endif -%}{%- endfor -%}
                  <label class="sw" style="--swatch:{{ hex }}" title="{{ value | escape }}"><input type="radio" name="options[{{ option.name | escape }}]" value="{{ value | escape }}"{% if option.selected_value == value %} checked{% endif %} aria-label="{{ value | escape }}"></label>
                {%- endfor -%}
                </div>
              {%- else -%}
                <div class="og{% if option.values.size == 2 %} og2{% elsif option.values.size == 3 %} og3{% elsif option.values.size == 4 %} og4{% endif %}">
                {%- for value in option.values -%}<label class="o"><input type="radio" name="options[{{ option.name | escape }}]" value="{{ value | escape }}"{% if option.selected_value == value %} checked{% endif %}>{{ value }}</label>{%- endfor -%}
                </div>
              {%- endif -%}
            </fieldset>
          {%- endfor -%}
        {%- endunless -%}
        {%- if fit_link != blank -%}<p class="sm" style="margin-top:-14px">Not sure of your size? <a class="tl" href="{{ fit_link }}">Find your fit</a></p>{%- endif -%}
        <div style="display:grid;gap:12px">
          {%- if settings.nl_popup -%}<button class="perk" type="button" data-vf-open="nl"><b>15% off</b><span>your first form when you join the Inner Circle</span></button>{%- endif -%}
          <button class="btn full" type="submit" data-vf-add style="min-height:60px"{% unless current.available %} disabled{% endunless %}><span data-vf-add-label>{% if current.available %}Add to bag · {{ current.price | money }}{% else %}Sold out{% endif %}</span></button>
          {%- assign ticks = section.settings.ticks | split: ',' -%}<ul class="ticks">{%- for t in ticks -%}<li>{% render 'vf-check' %}{{ t | strip | escape }}</li>{%- endfor -%}</ul>
        </div>
        </div>
      {%- endform -%}

      <div class="acc">
        <details open><summary>Details</summary><div class="pn">{{ product.description }}</div></details>
        <details><summary>Fit &amp; sizing</summary><div class="pn"><p>{{ product.metafields.custom.fit_note | default: section.settings.fit_text }}</p>{%- if fit_link != blank -%}<p><a class="tl" href="{{ fit_link }}">Find your fit</a></p>{%- endif -%}</div></details>
        <details><summary>Materials &amp; making</summary><div class="pn"><p>{{ product.metafields.custom.material | default: 'Premium polymer, specified for each colour. Material specification published at release.' }}</p><p>{{ product.metafields.custom.manufacturing | default: 'Designed, engineered and manufactured in-house, backed by 20 years of manufacturing experience.' }}</p></div></details>
        <details><summary>Care</summary><div class="pn"><p>{{ product.metafields.custom.care | default: section.settings.care_text }}</p></div></details>
        <details><summary>Shipping &amp; returns</summary><div class="pn"><p>{{ product.metafields.custom.lead_time | default: 'Made to order. Lead time is confirmed at checkout.' }}</p><p>{{ section.settings.shipping_text }}</p></div></details>
        <details><summary>Lifetime Lock Warranty</summary><div class="pn"><p>{{ section.settings.warranty_text }}</p></div></details>
      </div>
    </div>
  </div>

  <script type="application/json" data-vf-variants>[{%- for v in product.variants -%}{"id":{{ v.id | json }},"available":{{ v.available | json }},"options":{{ v.options | json }},"price":{{ v.price | json }},"priceFormatted":{{ v.price | money | json }},"compareAtPrice":{{ v.compare_at_price | default: 0 | json }},"compareAtPriceFormatted":{{ v.compare_at_price | money | json }},"featuredMediaId":{{ v.featured_media.id | default: 0 | json }}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]</script>
</div>
<div class="sbar" data-vf-sbar><div class="m"><b style="display:block;text-transform:uppercase">{{ product.title }}</b><span class="sm" data-vf-price>{{ current.price | money }}</span></div><button class="btn" type="button" data-vf-add data-vf-add-proxy data-short="1"{% unless current.available %} disabled{% endunless %}><span data-vf-add-label>Add to bag</span></button></div>
{% schema %}
{"name":"Product","settings":[
{"type":"text","id":"ticks","label":"Assurances (comma separated)","default":"Lifetime Lock Warranty, Plain unbranded shipping, Modular: replace any part later"},
{"type":"url","id":"fit_link","label":"Find your fit link","info":"Leave empty to use /pages/fit-lab"},
{"type":"textarea","id":"fit_text","label":"Fit text (if no fit_note metafield)","default":"Choose your base from your base circumference, or use Find your fit for a recommendation. If you are between two bases, choose the larger. Remove immediately if you feel numbness, coldness, discolouration or pain. Fit guidance is a starting point, not medical advice."},
{"type":"textarea","id":"care_text","label":"Care text (if no care metafield)","default":"Wash with warm water and mild, unscented soap after every wear, then air dry completely. Avoid boiling, dishwashers and alcohol-based cleaners."},
{"type":"textarea","id":"shipping_text","label":"Shipping text","default":"Ships in plain, unbranded packaging with a neutral name on your statement."},
{"type":"textarea","id":"warranty_text","label":"Warranty text","default":"The locking mechanism is covered for life. Claims are handled part by part, so we replace the part, not the product."}
]}
{% endschema %}
