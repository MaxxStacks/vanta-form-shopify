<section class="fitb"><div class="wrap">
  <div style="display:grid;gap:24px">
    <p class="k pop">{{ section.settings.eyebrow | escape }}</p>
    <h2 class="cap h1">{{ section.settings.heading | escape | newline_to_br }}<br><span class="pop">{{ section.settings.heading_pop | escape }}</span></h2>
    <p class="body" style="color:rgba(255,255,255,.68)">{{ section.settings.text | escape }}</p>
    <a class="btn p" style="justify-self:start" href="{{ section.settings.button_link | default: '/pages/fit-lab' }}">{{ section.settings.button_label | escape }}</a>
  </div>
  <div class="steps">{%- for block in section.blocks -%}<div {{ block.shopify_attributes }}><b>{{ forloop.index | prepend: '0' }}</b><span><b>{{ block.settings.title | escape }}</b><br>{{ block.settings.text | escape }}</span></div>{%- endfor -%}</div>
</div></section>
{% schema %}
{"name":"Fit system band","settings":[
{"type":"text","id":"eyebrow","label":"Eyebrow","default":"The VANTA fit system"},
{"type":"textarea","id":"heading","label":"Heading","default":"Not small.\nNot medium."},
{"type":"text","id":"heading_pop","label":"Accent line","default":"Yours."},
{"type":"textarea","id":"text","label":"Text","default":"Most cages fail on fit. Answer two questions and take one measurement. We match the form, the base and the lock to you."},
{"type":"text","id":"button_label","label":"Button label","default":"Find your fit"},
{"type":"url","id":"button_link","label":"Button link"}
],"max_blocks":4,"blocks":[{"type":"step","name":"Step","settings":[{"type":"text","id":"title","label":"Title","default":"What you want"},{"type":"text","id":"text","label":"Text","default":"Discreet, feminine, controlled, everyday"}]}],
"presets":[{"name":"Fit system band","blocks":[{"type":"step"},{"type":"step"},{"type":"step"},{"type":"step"}]}]}
{% endschema %}
