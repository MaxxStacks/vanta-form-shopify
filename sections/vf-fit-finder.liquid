{%- comment -%} Find your fit. Each block maps one answer to a collection; the result picks a product from it by experience level. {%- endcomment -%}
<div class="wrap" data-vf-fit>
  <div class="fit" data-vf-fit-stage>
    <noscript><h1 class="cap h1">Find your fit</h1><p class="body">Turn on JavaScript to use the fit finder, or read our <a class="tl" href="{{ section.settings.guide }}">size guide</a>.</p></noscript>
  </div>
  <script type="application/json" data-vf-fit-data>{
    "h1": {{ section.settings.heading | json }},
    "guide": {{ section.settings.guide | default: '/pages/fit-guide' | json }},
    "exp": [["first","This is my first","An easy, forgiving start"],["some","I have worn one before","Better than last time"],["exp","I am experienced","Built for long wear"]],
    "wants": [{%- for block in section.blocks -%}{%- assign c = block.settings.collection -%}{%- capture who -%}{% render 'vf-copy', key: c.handle, field: 'who' %}{%- endcapture -%}
      {"id": {{ block.id | json }}, "label": {{ block.settings.label | json }}, "desc": {{ block.settings.desc | json }}, "who": {{ who | strip | json }}, "url": {{ c.url | json }},
       "products": [{%- for p in c.products limit: 6 -%}{"title": {{ p.title | json }}, "url": {{ p.url | json }}, "variant": {{ p.selected_or_first_available_variant.id | json }}, "available": {{ p.available | json }}, "price": {{ p.price | json }}, "image": {% if p.featured_image %}{{ p.featured_image | image_url: width: 900 | json }}{% else %}null{% endif %}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}]
  }</script>
</div>
{% schema %}
{"name":"Find your fit","settings":[
{"type":"text","id":"heading","label":"First question","default":"What do you want most?"},
{"type":"url","id":"guide","label":"Size guide link","default":"/pages/fit-guide"}
],"blocks":[{"type":"want","name":"Answer","settings":[
{"type":"text","id":"label","label":"Answer","default":"Wear it every day"},
{"type":"text","id":"desc","label":"Description","default":"A balanced, comfortable form"},
{"type":"collection","id":"collection","label":"Recommends from collection"}
]}],"presets":[{"name":"Find your fit"}]}
{% endschema %}
