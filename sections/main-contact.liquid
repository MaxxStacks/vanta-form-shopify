<div class="wrap info">
  <p class="k pop">Contact</p>
  <h1 class="cap h1" style="margin-top:14px">Talk to<br>a person.</h1>
  <p class="body" style="margin-top:20px;max-width:56ch">Questions about fit, an order or a warranty claim. Measurements in text are enough for sizing help. You never need to send photos.</p>
  <div style="display:grid;gap:48px;margin-top:48px" class="contact-grid">
    {%- form 'contact', id: 'VfContact' -%}
      {%- if form.posted_successfully? -%}<p class="okmsg" style="margin-bottom:20px">Message received. We'll reply to the email you provided.</p>{%- endif -%}
      {%- if form.errors -%}<div class="err" style="margin-bottom:20px">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="fg">
        <div><label class="lbl" for="ContactName">Name</label><input class="inp" id="ContactName" type="text" name="contact[name]" autocomplete="name"></div>
        <div><label class="lbl" for="ContactEmail">Email</label><input class="inp" id="ContactEmail" type="email" name="contact[email]" autocomplete="email" required></div>
        <div class="w"><label class="lbl" for="ContactTopic">Topic</label><select class="inp" id="ContactTopic" name="contact[topic]"><option>Fit &amp; sizing</option><option>Existing order</option><option>Warranty claim</option><option>Bespoke</option><option>Retail or partnership</option><option>Other</option></select></div>
        <div class="w"><label class="lbl" for="ContactBody">Message</label><textarea class="inp" id="ContactBody" name="contact[body]" required></textarea></div>
      </div>
      <button class="btn" type="submit" style="margin-top:20px">Send privately</button>
    {%- endform -%}
  </div>
</div>
{% schema %}{"name":"Contact","settings":[]}{% endschema %}
