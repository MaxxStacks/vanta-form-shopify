<section class="vf-page-hero"><div class="page-width"><span class="eyebrow">VANTA FORM / Editorial</span><h1 class="vf-editorial">{{ blog.title }}</h1><p class="lead">Fit, design, manufacturing, discretion, identity and the culture around intimate wear.</p></div></section><section class="section"><div class="page-width">{% paginate blog.articles by 12 %}<div class="vf-journal-grid">{% for article in blog.articles %}<article class="vf-journal-card"><a href="{{ article.url }}">{% if article.image %}{{ article.image | image_url: width:900 | image_tag:loading:'lazy',alt:article.title }}{% endif %}<span class="eyebrow">{{ article.published_at | date:'%B %Y' }}</span><h2>{{ article.title }}</h2><p>{{ article.excerpt_or_content | strip_html | truncatewords:28 }}</p><span>Read →</span></a></article>{% else %}<div class="vf-empty-state"><h2>The Journal is being written.</h2><p>Long-form guidance and design notes will live here—written to inform, not to pad search rankings.</p></div>{% endfor %}</div>{% endpaginate %}</div></section>{% schema %}{"name":"Main blog","settings":[]}{% endschema %}