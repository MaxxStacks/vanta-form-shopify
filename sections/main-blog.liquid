<div class="wrap" style="padding-block:56px 120px">
  <p class="k pop">Journal</p>
  <h1 class="cap h1" style="margin-top:14px">{{ blog.title }}</h1>
  <p class="body" style="margin-top:18px">{{ section.settings.intro | escape }}</p>
  {%- paginate blog.articles by 12 -%}
  <div class="jr" style="margin-top:64px">
  {%- for article in blog.articles -%}
    <article class="jrow{% cycle '', ' rev' %}">
      <a href="{{ article.url }}">{% render 'vf-slot', image: article.image, caption: 'Editorial image for this article.', alt: article.title %}</a>
      <div style="display:grid;gap:18px"><p class="k pop">{{ article.tags.first | default: 'Journal' }} · {{ article.published_at | date: '%B %Y' }}</p><h2 class="cap h3"><a href="{{ article.url }}" style="text-decoration:none">{{ article.title }}</a></h2><p class="body">{{ article.excerpt_or_content | strip_html | truncatewords: 32 }}</p><a class="lnk" style="justify-self:start" href="{{ article.url }}">Read</a></div>
    </article>
  {%- else -%}
    <div class="empty"><h2 class="cap h3">The Journal is being written.</h2><p class="body">Guides on fit, care, relationships and expression will live here.</p></div>
  {%- endfor -%}
  </div>
  {%- if paginate.pages > 1 -%}<nav class="pager" aria-label="Pagination">{%- for part in paginate.parts -%}{%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- else -%}<span{% if part.title == paginate.current_page %} class="current"{% endif %}>{{ part.title }}</span>{%- endif -%}{%- endfor -%}</nav>{%- endif -%}
  {%- endpaginate -%}
</div>
{% schema %}{"name":"Blog","settings":[{"type":"text","id":"intro","label":"Intro","default":"Fit, relationships and expression, from the people who make the forms."}]}{% endschema %}
