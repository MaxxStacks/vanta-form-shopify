<section class="wrap" style="padding-bottom:120px">
  <div class="shead"><h2 class="cap h2">{{ section.settings.heading | escape }}</h2>{%- if section.settings.link_label != blank -%}<a class="lnk" href="{{ section.settings.link_url | default: routes.all_products_collection_url }}">{{ section.settings.link_label | escape }}</a>{%- endif -%}</div>
  <div class="cols">
    {%- for block in section.blocks -%}
      {%- assign c = block.settings.collection -%}
      {%- assign img = block.settings.image | default: c.featured_image -%}
      {%- assign title = block.settings.title | default: c.title -%}
      <a class="col" href="{{ c.url | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
        {% render 'vf-slot', image: img, caption: block.settings.caption, alt: title, sizes: '(min-width: 900px) 33vw, 50vw' %}
        <div class="row"><h3>{{ title | escape }}</h3>{%- if c.products.size > 0 -%}<span class="sm">From {{ c.products.first.price_min | money }}</span>{%- endif -%}</div>
        <p>{{ block.settings.text | default: c.description | strip_html | truncatewords: 16 | escape }}</p>
        <span class="lnk">Discover {{ title | escape }}</span>
      </a>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{"name":"Collection grid","settings":[
{"type":"text","id":"heading","label":"Heading","default":"The collection"},
{"type":"text","id":"link_label","label":"Link label","default":"View all forms"},
{"type":"url","id":"link_url","label":"Link"}
],"blocks":[{"type":"collection","name":"Collection","settings":[
{"type":"collection","id":"collection","label":"Collection"},
{"type":"text","id":"title","label":"Title override"},
{"type":"textarea","id":"text","label":"Short description"},
{"type":"image_picker","id":"image","label":"Image (defaults to collection image)"},
{"type":"textarea","id":"caption","label":"Art direction (shown until an image is set)","default":"Packshot on seamless white, three-quarter view, soft shadow."}
]}],"presets":[{"name":"Collection grid","blocks":[{"type":"collection"},{"type":"collection"},{"type":"collection"}]}]}
{% endschema %}
