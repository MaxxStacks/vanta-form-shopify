<article class="vf-article"><header class="vf-page-hero"><div class="page-width"><span class="eyebrow">VANTA FORM Journal · {{ article.published_at | date:'%B %d, %Y' }}</span><h1 class="vf-editorial">{{ article.title }}</h1>{% if article.excerpt != blank %}<p class="lead">{{ article.excerpt | strip_html }}</p>{% endif %}</div></header>{% if article.image %}<div class="page-width vf-article__image">{{ article.image | image_url:width:1800 | image_tag:loading:'eager',fetchpriority:'high',alt:article.title }}</div>{% endif %}<div class="page-width vf-prose vf-article__body">{{ article.content }}</div></article>{% schema %}{"name":"Main article","settings":[]}{% endschema %}