<div class="wrap"><div class="proof">
  {%- for block in section.blocks -%}<div {{ block.shopify_attributes }}><b>{{ block.settings.heading | escape }}</b><span>{{ block.settings.text | escape }}</span></div>{%- endfor -%}
</div></div>
{% schema %}
{"name":"Proof strip","max_blocks":4,"blocks":[{"type":"item","name":"Item","settings":[{"type":"text","id":"heading","label":"Heading","default":"Made to measure"},{"type":"text","id":"text","label":"Text","default":"Not small. Not medium. Yours."}]}],
"presets":[{"name":"Proof strip","blocks":[{"type":"item"},{"type":"item"},{"type":"item"},{"type":"item"}]}]}
{% endschema %}
